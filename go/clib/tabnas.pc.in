# pkg-config for libtabnasjsonl (tabnas-clib-template: v1)
# Install alongside the built library; substitute @PREFIX@ at install.
prefix=@PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libtabnasjsonl
Description: jsonl parser (libtabnasjsonl) — uniform tabnas C ABI (ADR-12)
Version: @VERSION@
Libs: -L${libdir} -ltabnasjsonl
Cflags: -I${includedir}
